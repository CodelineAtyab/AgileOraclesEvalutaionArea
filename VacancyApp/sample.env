# Copy this file to ".env" (same folder) and fill in real values.
# The .env file is loaded automatically at startup by spring-dotenv.
# IMPORTANT: add ".env" to your .gitignore so secrets are never committed.

# --- Oracle database ---
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_USERNAME=vacancy_app
DB_PASSWORD=change-me

# --- Slack ---
# Paste the Incoming Webhook URL from your Slack app.
SLACK_WEBHOOK_URL=paste_your_webhook_url
# Set to false to run locally without hitting Slack (reports are logged instead).
SLACK_ENABLED=true
