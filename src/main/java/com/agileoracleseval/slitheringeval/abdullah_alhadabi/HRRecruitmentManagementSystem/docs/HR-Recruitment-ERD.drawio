        <mxCell id="title" value="HR Recruitment Management System - Entity Relationship Diagram" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="30" width="760" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="vacant_jobs" value="&lt;div style=&quot;background:#ef3b24;color:#ffffff;padding:10px;font-size:17px;font-weight:bold;&quot;&gt;VACANT_JOBS&lt;/div&gt;&lt;div style=&quot;padding:10px;line-height:1.65;&quot;&gt;&lt;b&gt;PK&lt;/b&gt; job_id : NUMBER (IDENTITY)&lt;br&gt;job_title : VARCHAR2(150) NOT NULL&lt;br&gt;description : VARCHAR2(2000) NOT NULL&lt;br&gt;expires_at : TIMESTAMP NOT NULL&lt;br&gt;active_flag : CHAR(1) DEFAULT 'Y'&lt;br&gt;created_at : TIMESTAMP DEFAULT SYSTIMESTAMP&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="130" width="390" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="job_applications" value="&lt;div style=&quot;background:#ef3b24;color:#ffffff;padding:10px;font-size:17px;font-weight:bold;&quot;&gt;JOB_APPLICATIONS&lt;/div&gt;&lt;div style=&quot;padding:10px;line-height:1.65;&quot;&gt;&lt;b&gt;PK&lt;/b&gt; application_id : NUMBER (IDENTITY)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; job_id : NUMBER NOT NULL&lt;br&gt;applicant_name : VARCHAR2(150) NOT NULL&lt;br&gt;applicant_email : VARCHAR2(254) NOT NULL&lt;br&gt;applied_at : TIMESTAMP DEFAULT SYSTIMESTAMP&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="130" width="400" height="240" as="geometry"/>
        </mxCell>

        <mxCell id="notifications" value="&lt;div style=&quot;background:#ef3b24;color:#ffffff;padding:10px;font-size:17px;font-weight:bold;&quot;&gt;NOTIFICATIONS&lt;/div&gt;&lt;div style=&quot;padding:10px;line-height:1.65;&quot;&gt;&lt;b&gt;PK&lt;/b&gt; notification_id : NUMBER (IDENTITY)&lt;br&gt;notification_type : VARCHAR2(30) NOT NULL&lt;br&gt;subject : VARCHAR2(200) NOT NULL&lt;br&gt;body : CLOB NOT NULL&lt;br&gt;status : VARCHAR2(10) DEFAULT 'PENDING'&lt;br&gt;dedup_key : VARCHAR2(200) UNIQUE&lt;br&gt;attempt_count : NUMBER DEFAULT 0&lt;br&gt;created_at : TIMESTAMP DEFAULT SYSTIMESTAMP&lt;br&gt;sent_at : TIMESTAMP NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1150" y="130" width="390" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="jobs_archive" value="&lt;div style=&quot;background:#555555;color:#ffffff;padding:10px;font-size:17px;font-weight:bold;&quot;&gt;JOBS_POSTING_ARCHIVE&lt;/div&gt;&lt;div style=&quot;padding:10px;line-height:1.65;&quot;&gt;&lt;b&gt;PK&lt;/b&gt; job_id : NUMBER&lt;br&gt;job_title : VARCHAR2(150) NOT NULL&lt;br&gt;description : VARCHAR2(2000) NOT NULL&lt;br&gt;expires_at : TIMESTAMP NOT NULL&lt;br&gt;created_at : TIMESTAMP NOT NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
